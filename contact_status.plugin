__id__ = "contact_status"
__name__ = "Contact Status"
__type__ = "plugin"
__description__ = "Show mutual contact status and phone number country in user profiles"
__version__ = "1.5.0"
__author__ = "@xwvux"
__min_version__ = "12.2.10"

